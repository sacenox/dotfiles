#!/usr/bin/env bash
# hax-adversary — run the adversarial agent as an isolated hax -p subprocess.
#
# Usage:
#   hax-adversary <brief...>
#   echo "<brief>" | hax-adversary
#   hax-adversary < brief.txt
#
set -euo pipefail

if [ "$#" -gt 0 ]; then
	exec hax -p --preset=adversary --no-session "$@"
fi

if [ ! -t 0 ]; then
	exec hax -p --preset=adversary --no-session
fi

echo "usage: hax-adversary <brief>   (or pipe the brief via stdin)" >&2
exit 1
