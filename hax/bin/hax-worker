#!/usr/bin/env bash
# hax-worker — run the worker agent as an isolated hax -p subprocess.
#
# Usage:
#   hax-worker <brief...>
#   echo "<brief>" | hax-worker
#   hax-worker < brief.txt
#
set -euo pipefail

if [ "$#" -gt 0 ]; then
	exec hax -p --preset=implementer --no-session "$@"
fi

if [ ! -t 0 ]; then
	exec hax -p --preset=implementer --no-session
fi

echo "usage: hax-worker <brief>   (or pipe the brief via stdin)" >&2
exit 1
