#!/usr/bin/env bash
# hax-implementer — run the implementation agent as an isolated hax -p subprocess.
#
# Usage:
#   hax-implementer <brief...>
#   echo "<brief>" | hax-implementer
#   hax-implementer < brief.txt
#
set -euo pipefail

if [ "$#" -gt 0 ]; then
	exec hax -p --preset=implementer --no-session "$@"
fi

if [ ! -t 0 ]; then
	exec hax -p --preset=implementer --no-session
fi

echo "usage: hax-implementer <brief>   (or pipe the brief via stdin)" >&2
exit 1
