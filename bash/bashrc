# User-local binaries, e.g. npm global installs (prefix is ~/.local, see ~/.npmrc).
# Set before the interactive guard so non-interactive shells see it too.
export PATH="$HOME/.local/bin:$PATH"

[[ $- != *i* ]] && return

export EDITOR=nvim

alias ls='ls --color'
alias ll='ls -alF'

alias g='git'
alias gst='git status'
alias gc='git commit --verbose'
alias gp='git pull --rebase'
alias gpo='git push origin'
alias nv='nvim'
alias sto='cd /mnt/storage'
alias rep='cd /mnt/storage/repos'

# Credentials loaded from ~/.keys.json
if [ -f "$HOME/.keys.json" ]; then
  eval "$(jq -r 'to_entries[] | "export \(.key)=\(.value | @sh)"' "$HOME/.keys.json")"
fi

greet() {
  local cows=(
    "default" "flaming-sheep" "fox" "llama" "sheep" "skeleton" "three-eyes" "tux" "udder" "www"
  )
  local count=${#cows[@]}
  local idx
  if [ -n "${ZSH_VERSION:-}" ]; then
    idx=$((RANDOM % count + 1))
  else
    idx=$((RANDOM % count))
  fi
  local cow=${cows[$idx]:-"default"}
  fortune -s | cowsay -f "$cow" -W 80 | lolcat -p 1.0 -F 0.06 -S "$RANDOM"
}
# Uncomment to get a nice greeting.
greet

eval "$(fzf --bash)"
eval "$(starship init bash)"
