[[ $- != *i* ]] && return

export EDITOR=nvim

alias ls='ls --color'
alias ll='ls -alF'

alias g='git'
alias gst='git status'
alias gc='git commit --verbose'
alias gp='git pull --rebase'
alias gpo='git push origin'
alias nv='nvim'

export PATH=$PATH:~/.local/bin
export PATH="$(go env GOPATH)/bin:$PATH"

# Credentials loaded from ~/.config/keys.json
if [ -f "$HOME/.config/keys.json" ]; then
  while IFS='=' read -r key value; do
    export "$key=$value"
  done < <(python3 -c '
import json, sys
with open(sys.argv[1]) as f:
    for k, v in json.load(f).items():
        print(f"{k}={v}")
' "$HOME/.config/keys.json")
fi

greet() {
  local cows=(
    "default" "flaming-sheep" "fox" "llama" "sheep" "skeleton" "three-eyes" "tux" "udder" "www"
  )
  local count=${#cows[@]}
  local idx
  if [ -n "${ZSH_VERSION:-}" ]; then
    idx=$((RANDOM % count + 1))
  else
    idx=$((RANDOM % count))
  fi
  local cow=${cows[$idx]:-"default"}
  fortune -s | cowsay -f "$cow" -W 80 | lolcat -p 1.0 -F 0.06 -S "$RANDOM"
}

# Uncomment to get a nice greeting.
greet

eval "$(fzf --bash)"
eval "$(starship init bash)"
