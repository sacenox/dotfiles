{
  "tools": [
    "read",
    "bash"
  ],
  "snapshotIgnoreDirs": [
    "*lock.json",
    ".git"
  ],
  "snapshotDiffsInContext": true,
  "programStatus": true,
  "notifications": "both",
  "showImages": true,
  "colorscheme": {
    "comment": "#506477",
    "prompt": "#91B4D5",
    "accent": "#ADD7FF",
    "err": "#D0679D",
    "warn": "#FFFAC2",
    "code": "#5FB3A1",
    "output": "#E4F0FB",
    "diff_add": "#5DE4C7",
    "diff_delete": "#D0679D",
    "inline_code": "#A6ACCD",
    "link": "#91B4D5",
    "uri": "#89DDFF",
    "heading1": "#5FB3A1",
    "heading2": "#FFFAC2",
    "heading3": "#D0679D",
    "heading4": "#FCC5E9",
    "heading5": "#89DDFF",
    "heading6": "#ADD7FF"
  }
}
