{
  "permissions": {
    "defaultMode": "{{ claude.permissionMode }}"
  },
  "effortLevel": "{{ claude.effort }}",
  "skipDangerousModePermissionPrompt": true,
  "theme": "{{ claude.theme }}",
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"\\(.model.display_name) · ctx \\(.context_window.used_percentage // 0 | floor)%\"'"
  }
}
