{
  "theme": "{{ agent.theme }}",
  "provider": "{{ agent.provider }}",
  "model": "{{ agent.model }}",
  "thinkingEffort": "{{ agent.thinkingEffort }}",
  "tools": [
    "edit",
    "read",
    "bash"
  ],
  "snapshotIgnoreDirs": [
    ".git"
  ],
  "mcpServers": {
    "firecrawl": {
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "headers": { "Authorization": "{{ FIRECRAWL_API_KEY }}" }
    }
  }
}
