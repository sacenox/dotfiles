# This is the configuration file for Ghostty.
#

font-family = ZedMono Nerd Font Mono
# font-family = CommitMono Nerd Font Mono

# font-family = Monaspace Argon NF
# font-family = Monaspace Neon NF
# font-family = Monaspace Xenon NF
# font-family = Monaspace Krypton NF
# font-family = Monaspace Radon NF

font-size = 12
window-width = 150
window-height = 32
unfocused-split-opacity = 1

# theme = 0x96f
# theme = Zenwritten Dark
theme = Gruvbox Dark Hard

# Send a literal LF for Shift+Enter so terminal agents (hax, etc.) can insert
# newlines; Ghostty otherwise sends the CSI sequence [27;2;13~ which they
# ignore.
keybind = shift+enter=text:\n
